#!/bin/sh
# {{ _javatools_launcher }}
# Rendered by the infrashift 'java-tools' devcontainer feature. Edits are overwritten.
#
# Launches the Eclipse JDT Language Server {{ _jdtls_version }} ({{ _jdtls_build }}).
# A shell replacement for the upstream bin/jdtls, which is a Python script: it
# takes the same arguments nvim-jdtls passes --
#
#   -configuration <dir>   per-project OSGi configuration (writable)
#   -data <dir>            per-project workspace
#   --jvm-arg=<arg>        one extra JVM argument (repeatable)
#
# -- and always adds the lombok agent. Anything else is passed to jdtls as is.
set -eu

JDTLS_HOME={{ _javatools_jdtls_dir }}
LOMBOK={{ _javatools_root }}/lombok.jar

if [ -n "${JAVA_HOME:-}" ] && [ -x "${JAVA_HOME}/bin/java" ]; then
    JAVA="${JAVA_HOME}/bin/java"
elif [ -x "${HOME}/.local/share/java/bin/java" ]; then
    JAVA="${HOME}/.local/share/java/bin/java"
else
    JAVA=java
fi

config="${XDG_CACHE_HOME:-${HOME}/.cache}/jdtls/config"
data="${XDG_CACHE_HOME:-${HOME}/.cache}/jdtls/workspace"
jvm_args=""
rest=""
while [ $# -gt 0 ]; do
    case "$1" in
        -configuration) config="$2"; shift 2 ;;
        -data)          data="$2"; shift 2 ;;
        --jvm-arg=*)    jvm_args="${jvm_args} ${1#--jvm-arg=}"; shift ;;
        *)              rest="${rest} $1"; shift ;;
    esac
done

launcher=$(ls "${JDTLS_HOME}"/plugins/org.eclipse.equinox.launcher_*.jar 2>/dev/null | head -n 1)
[ -n "${launcher}" ] || { echo "jdtls: no equinox launcher under ${JDTLS_HOME}/plugins" >&2; exit 1; }
mkdir -p "${config}" "${data}"

# shellcheck disable=SC2086  # jvm_args and rest are word lists on purpose
exec "${JAVA}" \
    -Declipse.application=org.eclipse.jdt.ls.core.id1 \
    -Dosgi.bundles.defaultStartLevel=4 \
    -Declipse.product=org.eclipse.jdt.ls.core.product \
    -Dosgi.checkConfiguration=true \
    -Dosgi.sharedConfiguration.area="${JDTLS_HOME}/{{ _javatools_config_dir }}" \
    -Dosgi.sharedConfiguration.area.readOnly=true \
    -Dosgi.configuration.cascaded=true \
    -Xms1G \
    --add-modules=ALL-SYSTEM \
    --add-opens java.base/java.util=ALL-UNNAMED \
    --add-opens java.base/java.lang=ALL-UNNAMED \
    -javaagent:"${LOMBOK}" \
    ${jvm_args} \
    -jar "${launcher}" \
    -configuration "${config}" \
    -data "${data}" \
    ${rest}

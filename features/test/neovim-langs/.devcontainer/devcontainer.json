{
    // Test harness for the repo-local LANGUAGE features: python-tools, java-tools,
    // ansible-tools, and lazyvim with every extra they serve. `make
    // test-feature-template FEATURE_TEST=neovim-langs` stages features/src/* next
    // to this file, so "./lazyvim" etc. resolve to the working tree. The trusted
    // features are the ones the python, java and ansible-cue templates pin, at the
    // same digests (and the one bootstrap every template pins).
    //
    // One image for all three languages, on purpose: it proves the extras compose
    // (one lockfile, several extras, one spec) as well as each tool on its own.
    "build": {
        "dockerfile": "../../../../shared/Containerfile"
    },
    "containerUser": "dev",
    "updateRemoteUserUID": false,
    "features": {
        "ghcr.io/infrashift/trusted-devcontainer-features/bootstrap@sha256:7f5bc8021fc701d0141dc4937b9faebfc2abcadcb905530fd3513ee4ee5df70b": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/git@sha256:07a52095bed925bffa3ac3d35e657ec0a3bf66b8d9ce34fa546095f0a9c5794d": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/python@sha256:49f88bfe87b4553456be9969da18c3596fc40f9717642ec5e2691179fdd41553": {"target_version": "3.14"},
        "ghcr.io/infrashift/trusted-devcontainer-features/uv-ruff@sha256:1ae28f3e7b3e5ef55a28eb87975466c515df469659e921f284c3bef64eaa1e04": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/openjdk@sha256:d27ddd2fc4911685480b032bdccf16b208e058795b469af9ec4396ce999b6124": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/ansible-core@sha256:52b5bd3177124e0e44eedd026b5a9fd8812b1ac8e9d6b3004e024ab238a4ebf3": {"target_version": "2.21.3", "target_python_version": "3.14"},
        "ghcr.io/infrashift/trusted-devcontainer-features/cuelang@sha256:417051cbac4b4eb7dde6fa9e29c79d250fde98e4faab8fd8279ff3ce14f040e4": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/sshd@sha256:82f2159de8a4b6316348b0c23c7e2eabf544b3771465f18a6c0a68ba5ceae252": {},
        "./tmux": {},
        "./neovim": {},
        "./python-tools": {},
        "./java-tools": {},
        "./ansible-tools": {},
        "./lazyvim": { "extras": "lang.python,lang.java,infrashift.cue,infrashift.ansible_lint" }
    }
}

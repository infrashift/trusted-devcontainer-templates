{
    // Test harness for the repo-local features. `make test-feature-template`
    // stages features/src/* next to this file, so "./tmux" etc. resolve to the
    // working tree rather than to anything published. The trusted-devcontainer-
    // features references are digest-pinned like the templates' own, and
    // `make pin-features` keeps them in step.
    //
    // No overrideFeatureInstallOrder: the features' own installsAfter orders
    // them (lazyvim after neovim and go-tools, go-tools after golang), which is
    // exactly the ordering a consumer of the published features gets.
    "build": {
        "dockerfile": "../../../../shared/Containerfile"
    },
    "containerUser": "dev",
    "updateRemoteUserUID": false,
    "features": {
        "ghcr.io/infrashift/trusted-devcontainer-features/bootstrap@sha256:5f7d508100f879933cb307544aa7135eb1e238d4d2b2866443a7c27e24ec8b9d": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/git@sha256:b0376331c9c6053a1ace30d3b946b8ff2f3e8d8e0676eac96319bb210a6ad16b": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/golang@sha256:f35826772a85bcf526f4f6b7dff553414a32fc1ef315d5590f6452ccae7d18a6": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/sshd@sha256:8cf3aa2fd16a46095e57e93450f292818c6b1e513985ef52edf23a9ca30318a5": {},
        "./tmux": {},
        "./neovim": {},
        "./go-tools": {},
        "./lazyvim": {}
    }
}

FROM ghcr.io/infrashift/trusted-base-images/trusted/ubi9-standard@sha256:f938c070dc5906b9915a0c056e85a002a00900af17a08bfa4783fb80a45ad889

USER root

# Silence subscription-manager messages (TODO: move to base image)
RUN echo "enabled=0" >> /etc/yum/pluginconf.d/subscription-manager.conf

# TODO(ISSUE): WORKAROUND — sudo is only needed because the Ansible playbooks in
# infrashift/trusted-devcontainer-features assume sudo is present when installing
# features (e.g. git). The real fix is to update the feature Ansible roles to not
# require sudo when already running as root. Once that is fixed upstream, remove
# this dnf install and the corresponding layer.
RUN dnf install -y sudo && dnf clean all

# Create the devcontainer user
ARG USERNAME=dev
ARG USER_UID=1001
ARG USER_GID=1001

RUN groupadd --gid ${USER_GID} ${USERNAME} \
    && useradd -m -s /bin/bash --uid ${USER_UID} --gid ${USER_GID} ${USERNAME}

# Install uv for feature bootstrap
RUN curl -LsSf https://astral.sh/uv/install.sh | env INSTALLER_NO_MODIFY_PATH=1 UV_INSTALL_DIR=/usr/local/bin sh \
    && uv --version

USER ${USERNAME}

ENV HOME=/home/${USERNAME}
ENV PATH="/home/${USERNAME}/.local/bin:${PATH}"

RUN mkdir -p ${HOME}/.local/bin \
    && echo 'export PATH="${HOME}/.local/bin:${PATH}"' >> ${HOME}/.bashrc \
    && echo 'export PATH="${HOME}/.local/bin:${PATH}"' >> ${HOME}/.bash_profile

CMD ["sleep", "infinity"]

{
    "build": {
        "dockerfile": "./Containerfile",
        "context": ".."
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "workspaceFolder": "/workspace",
    "containerUser": "dev",
    "updateRemoteUserUID": false,
    "customizations": {
        "vscode": {
            "settings": {
                "json.schemas": [
                    {
                        "fileMatch": [
                            "*/devcontainer-feature.json"
                        ],
                        "url": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainerFeature.schema.json"
                    },
                    {
                        "fileMatch": [
                            "*/devcontainer-template.json"
                        ],
                        "url": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainerTemplate.schema.json"
                    }
                ],
                "terminal.integrated.defaultProfile.linux": "bash"
            },
            "extensions": [
                "usernamehw.indent-one-space",
                "DavidAnson.vscode-markdownlint",
                "bierner.github-markdown-preview"
            ]
        }
    },
    "features": {
        "ghcr.io/infrashift/trusted-devcontainer-features/git": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/git-lfs": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/golang": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/cuelang": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/jq": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/yq": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/uv-ruff": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/grype": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/syft": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/nodejs": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/npm": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/pnpm": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/python": {
            "target_version": "3.12"
        },
        "ghcr.io/infrashift/trusted-devcontainer-features/ansible-core": {
            "target_version": "2.18.2",
            "target_python_version": "3.12"
        },
        "ghcr.io/infrashift/trusted-devcontainer-features/openjdk": {},
        "ghcr.io/infrashift/trusted-devcontainer-features/dotnet": {}
    }
}

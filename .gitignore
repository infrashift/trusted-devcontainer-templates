# Private keys, in any form, anywhere in the tree. An encrypted cosign.key
# currently lives here untracked; this is what keeps `git add -A` from
# committing it. .gitleaks.toml is the second guard, and the PDP's
# SECRET_DETECTED rule is the third.
**/*.key
**/*.pem
**/*.env
**/*.secret

# Generated by `make repo-gate` / the repo-gate CI job.
repo-decision.json

# Build evidence produced locally by scripts/build-template.sh.
evidence/

docs/dist/
docs/node_modules/
docs/.astro/

# Repo-local features staged into the feature test template by
# `make test-feature-template` (see features/README.md).
features/test/*/.devcontainer/*/
features/test/*/test-lib.sh
!features/test/shared/test-lib.sh
features/test/*/.devcontainer/devcontainer-lock.json
